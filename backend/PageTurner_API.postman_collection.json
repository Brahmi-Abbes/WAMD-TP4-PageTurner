    {
      "name": "2. Product Management (CRUD)",
      "item": [
        {
          "name": "6. Retrieve All Products (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns products array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.products).to.be.an('array');",
                  "    if (json.products.length > 0 && !pm.collectionVariables.get('productId')) {",
                  "        pm.collectionVariables.set('productId', json.products[0]._id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Retrieves all bookstore products (public endpoint)."
          },
          "response": []
        },
        {
          "name": "7. Create Product (Protected - JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.product && json.product._id) {",
                  "    pm.collectionVariables.set('productId', json.product._id);",
                  "    console.log('New product ID saved: ' + json.product._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Node.js Design Patterns\",\n  \"description\": \"Master best practices and design patterns for building scalable Node.js applications.\",\n  \"price\": 45.99,\n  \"category\": \"Technology\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1532012164546-f432f2e3777a\",\n  \"stock\": 14\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Creates a new book in the bookstore catalog. Requires valid JWT."
          },
          "response": []
        },
        {
          "name": "8. Retrieve One Product by ID (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Retrieves one specific book by its MongoDB ObjectId."
          },
          "response": []
        },
        {
          "name": "9. Update Product (Protected - JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product price and stock updated', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.product.price).to.eql(42.5);",
                  "    pm.expect(json.product.stock).to.eql(20);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 42.50,\n  \"stock\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Updates an existing product. Requires valid JWT."
          },
          "response": []
        },
        {
          "name": "10. Delete Product (Protected - JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Deletes the product created in request 7. Requires valid JWT."
          },
          "response": []
        }
      ]
    },
