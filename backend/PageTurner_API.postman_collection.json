    {
      "name": "4. Rate Limiting",
      "item": [
        {
          "name": "15. Repeated Catalog Requests (General Limiter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Demonstrates general rate limiting (max 100 requests per 15 minutes per IP)."
          },
          "response": []
        },
        {
          "name": "16. Login Rate Limiter (Exceed 5 attempts -> Expect 429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: Run this request repeatedly (> 5 times) to observe HTTP 429",
                  "if (pm.response.code === 429) {",
                  "    pm.test('Rate limit triggered: 429 Too Many Requests', function () {",
                  "        pm.expect(pm.response.code).to.eql(429);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"spammer@example.com\",\n  \"password\": \"guesspassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Send more than 5 requests to observe HTTP 429 Too Many Requests response."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. OAuth 2.0 (Google)",
      "item": [
        {
          "name": "17. Google OAuth Login Redirect URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Initiates Google OAuth 2.0 authorization code flow. When opened in a browser, presents Google consent screen."
          },
          "response": []
        },
        {
          "name": "18. Direct Google ID Token Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('PageTurner JWT received from Google token exchange.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/verify-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google", "verify-token"]
            },
            "description": "Directly exchanges a Google ID Token (from Google Cloud / Postman OAuth2) for a PageTurner application JWT."
          },
          "response": []
        }
      ]
    }
