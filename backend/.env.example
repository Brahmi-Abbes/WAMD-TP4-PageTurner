# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB: mongodb://localhost:27017/pageturner
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pageturner?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pageturner

# JSON Web Token (JWT) Configuration
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Allowed Client Origin (React + Redux bookstore frontend from TP2)
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth 2.0 Credentials (Optional: From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
